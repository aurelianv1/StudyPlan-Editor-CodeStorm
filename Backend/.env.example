# Copy this file to .env and fill in the values.

# API key for the Groq chat completions API (https://console.groq.com/keys).
# The /chat endpoint answers with HTTP 503 while this is empty.
GROQ_API_KEY=

# Model used by the AI assistant.
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=5

# Set to true to serve the canned hackathon demo scenarios instead of
# analysing the uploaded files. Keep it off for real documents.
DEMO_MODE=false
